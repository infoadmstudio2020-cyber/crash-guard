<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/crashguard_bg"
    android:padding="16dp">

    <!-- Header Alert Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/crashguard_card_bg"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_crash_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRASH INTERCEPTED"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/crashguard_badge_text"
            android:background="@color/crashguard_badge_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_crash_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crashguard_crash_title"
            android:textColor="@color/crashguard_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_crash_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/crashguard_crash_subtitle"
            android:textColor="@color/crashguard_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_exception_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FB7185"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_exception_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/crashguard_text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Details Scroll Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/crashguard_code_bg"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_stacktrace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/crashguard_code_text"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_copy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/crashguard_btn_copy"
            android:textAllCaps="false"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/crashguard_btn_share"
            android:textAllCaps="false"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/crashguard_btn_close"
            android:textAllCaps="false"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_restart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/crashguard_btn_restart"
            android:textAllCaps="false"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
